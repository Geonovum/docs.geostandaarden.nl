RewriteEngine On
# Redirect map-root en onderliggende paden naar de nieuwste versie-map
RewriteRule ^$           /ldv/basis-hr-logboek-dataverwerkingen-voor-objecten-20260924/ [R=302,L]
RewriteRule ^(.+)$       /ldv/basis-hr-logboek-dataverwerkingen-voor-objecten-20260924/$1 [R=302,L]
Options -Indexes
